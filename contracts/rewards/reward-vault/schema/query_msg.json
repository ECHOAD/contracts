{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "campaign"
      ],
      "properties": {
        "campaign": {
          "type": "object",
          "required": [
            "campaign_id",
            "host"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "One host's campaigns, in campaign id order.",
      "type": "object",
      "required": [
        "campaigns"
      ],
      "properties": {
        "campaigns": {
          "type": "object",
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Lets the backend confirm a payout from state, without looking the tx up by hash.",
      "type": "object",
      "required": [
        "claim"
      ],
      "properties": {
        "claim": {
          "type": "object",
          "required": [
            "campaign_id",
            "claim_id",
            "host"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            },
            "claim_id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "address_claims"
      ],
      "properties": {
        "address_claims": {
          "type": "object",
          "required": [
            "address",
            "campaign_id",
            "host"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "campaign_id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "campaign_nfts"
      ],
      "properties": {
        "campaign_nfts": {
          "type": "object",
          "required": [
            "campaign_id",
            "host",
            "tier_id"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "string",
                "null"
              ]
            },
            "tier_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
