{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Host creates the event's campaign. The same message deposits, for every native tier, `max_claims * (amount_per_claim + fee)` and, for every NFT tier, `max_claims * nft_fee`. The NFTs follow with `SendNft`.",
      "type": "object",
      "required": [
        "create_campaign"
      ],
      "properties": {
        "create_campaign": {
          "type": "object",
          "required": [
            "campaign_id",
            "claim_end",
            "reservation_end",
            "tiers"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            },
            "claim_end": {
              "$ref": "#/definitions/Timestamp"
            },
            "per_address_cap": {
              "description": "Optional cap on claims per address across all tiers.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "reservation_end": {
              "$ref": "#/definitions/Timestamp"
            },
            "tiers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TierInput"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "cw721 hook: the host sends a reward NFT with `SendNft` and `msg = {\"campaign_id\": \"...\", \"tier_id\": \"...\"}`.",
      "type": "object",
      "required": [
        "receive_nft"
      ],
      "properties": {
        "receive_nft": {
          "$ref": "#/definitions/Cw721ReceiveMsg"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Distributor pays a batch of authorized claims of one host's campaign.",
      "type": "object",
      "required": [
        "payout"
      ],
      "properties": {
        "payout": {
          "type": "object",
          "required": [
            "campaign_id",
            "host",
            "items"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PayoutItem"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "After `reservation_end`, or once cancelled. The first call returns the unspent rewards and fees, alone, so no NFT transfer can block them. Later calls return up to `max_batch` NFTs each, from every tier or only from `tier_id`, so a collection that refuses transfers cannot block the others. Anyone can call it; funds only go to the host.",
      "type": "object",
      "required": [
        "refund"
      ],
      "properties": {
        "refund": {
          "type": "object",
          "required": [
            "campaign_id",
            "host"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "tier_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Host cancels its campaign while some NFT tier is incomplete. Returns the unspent rewards and fees at once; the NFTs follow with `Refund`.",
      "type": "object",
      "required": [
        "cancel_unfunded"
      ],
      "properties": {
        "cancel_unfunded": {
          "type": "object",
          "required": [
            "campaign_id"
          ],
          "properties": {
            "campaign_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Owner updates platform settings. Funded campaigns keep their fee snapshot.",
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "properties": {
            "distributor": {
              "type": [
                "string",
                "null"
              ]
            },
            "fee_bps": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "minimum": 0.0
            },
            "fee_collector": {
              "type": [
                "string",
                "null"
              ]
            },
            "max_batch": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "max_claim_window_secs": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "max_reservation_secs": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "min_fee": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nft_fee": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Uint128"
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "Cw721ReceiveMsg": {
      "description": "Cw721ReceiveMsg should be de/serialized under `Receive()` variant in a ExecuteMsg",
      "type": "object",
      "required": [
        "msg",
        "sender",
        "token_id"
      ],
      "properties": {
        "msg": {
          "$ref": "#/definitions/Binary"
        },
        "sender": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PayoutItem": {
      "type": "object",
      "required": [
        "claim_id",
        "recipient",
        "tier_id"
      ],
      "properties": {
        "claim_id": {
          "description": "Backend claim id. Single-use inside its campaign.",
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "tier_id": {
          "type": "string"
        },
        "token_id": {
          "description": "Required for NFT tiers, forbidden for native ones.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RewardInput": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "native"
          ],
          "properties": {
            "native": {
              "type": "object",
              "required": [
                "amount_per_claim"
              ],
              "properties": {
                "amount_per_claim": {
                  "$ref": "#/definitions/Uint128"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "nft"
          ],
          "properties": {
            "nft": {
              "type": "object",
              "required": [
                "collection"
              ],
              "properties": {
                "collection": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "TierInput": {
      "description": "One kind of prize of the event.",
      "type": "object",
      "required": [
        "max_claims",
        "per_address_cap",
        "reward",
        "tier_id"
      ],
      "properties": {
        "max_claims": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "per_address_cap": {
          "description": "Claims one address can receive from this tier (1 to `max_claims`).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reward": {
          "$ref": "#/definitions/RewardInput"
        },
        "tier_id": {
          "description": "1 to 32 characters from [A-Za-z0-9_-], unique inside the campaign.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Timestamp": {
      "description": "A point in time in nanosecond precision.\n\nThis type can represent times from 1970-01-01T00:00:00Z to 2554-07-21T23:34:33Z.\n\n## Examples\n\n``` # use cosmwasm_std::Timestamp; let ts = Timestamp::from_nanos(1_000_000_202); assert_eq!(ts.nanos(), 1_000_000_202); assert_eq!(ts.seconds(), 1); assert_eq!(ts.subsec_nanos(), 202);\n\nlet ts = ts.plus_seconds(2); assert_eq!(ts.nanos(), 3_000_000_202); assert_eq!(ts.seconds(), 3); assert_eq!(ts.subsec_nanos(), 202); ```",
      "allOf": [
        {
          "$ref": "#/definitions/Uint64"
        }
      ]
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    },
    "Uint64": {
      "description": "A thin wrapper around u64 that is using strings for JSON encoding/decoding, such that the full u64 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u64` to get the value out:\n\n``` # use cosmwasm_std::Uint64; let a = Uint64::from(42u64); assert_eq!(a.u64(), 42);\n\nlet b = Uint64::from(70u32); assert_eq!(b.u64(), 70); ```",
      "type": "string"
    }
  }
}
